{
  "name": "@wazoo/reasoner",
  "description": "OWL 2 RL materialization over RDF/JS terms: semi-naive, indexed, with owl:sameAs as a union-find and incremental additions.",
  "version": "0.1.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "publish": {
    "include": ["src/", "README.md", "LICENSE"],
    "exclude": ["src/**/*.test.ts"]
  },
  "imports": {
    "@/": "./src/",
    "@rdfjs/types": "npm:@rdfjs/types@^2.0.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@wazoo/sparql-engine": "jsr:@wazoo/sparql-engine@0.4.4",
    "rdfjs-inference-engine": "npm:rdfjs-inference-engine@0.2.2"
  },
  "tasks": {
    "ci": {
      "description": "Formats, lints, checks, and tests the code",
      "dependencies": ["fmt:check", "lint", "check", "test"]
    },
    "check": "deno check src/ test/ bench/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "test": "deno test --allow-read src/ test/unit/",
    "test:parity": "deno run --allow-read --allow-env test/parity/parity.ts",
    "bench": "deno run --allow-read --allow-hrtime bench/scaling.ts",
    "publish:dry": "deno publish --dry-run --allow-dirty"
  }
}
