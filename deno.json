{
  "name": "@wazoo/reasoner",
  "description": "OWL 2 RL materialization over RDF/JS terms: semi-naive, indexed, with owl:sameAs as a union-find and incremental additions.",
  "version": "0.4.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts"
  },
  "publish": {
    "include": ["src/", "README.md", "LICENSE"],
    "exclude": ["src/**/*.test.ts"]
  },
  "imports": {
    "@/": "./src/",
    "@rdfjs/types": "npm:@rdfjs/types@^2.0.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/cli": "jsr:@std/cli@^1.0.32",
    "@wazoo/sparql-engine": "jsr:@wazoo/sparql-engine@0.4.4",
    "rdfjs-inference-engine": "npm:rdfjs-inference-engine@0.2.2",
    "rdfxml-streaming-parser": "npm:rdfxml-streaming-parser@3.1.0"
  },
  "tasks": {
    "ci": {
      "description": "Formats, lints, checks, and tests the code",
      "dependencies": ["fmt:check", "lint", "check", "test"]
    },
    "check": "deno check src/ test/ bench/",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "lint": "deno lint",
    "test": "deno test --allow-read src/ test/unit/",
    "test:differential": "deno run --allow-read test/differential/run.ts",
    "test:w3c": "deno run --allow-read --allow-write=.cache --allow-net=www.w3.org --allow-env test/w3c/run.ts",
    "test:w3c:update": "deno run --allow-read --allow-write=.cache,test/w3c/expected-pass.json --allow-net=www.w3.org --allow-env test/w3c/run.ts --update",
    "test:parity": "deno run --allow-read --allow-env test/parity/parity.ts",
    "bench": "deno run --allow-read bench/scaling.ts",
    "bench:check": "deno run --allow-read bench/scaling.ts --check --profile sameas --sizes 4e3,8e3,1.6e4,3.2e4 && deno run --allow-read bench/scaling.ts --check --profile equality --sizes 4e3,8e3,1.6e4 && deno run --allow-read bench/scaling.ts --check --profile delete --sizes 4e3,8e3,1.6e4,3.2e4 && deno run --allow-read bench/scaling.ts --check --profile fpliteral --sizes 2e3,8e3,3.2e4",
    "publish:dry": "deno publish --dry-run --allow-dirty"
  },
  "compilerOptions": { "strict": true }
}
